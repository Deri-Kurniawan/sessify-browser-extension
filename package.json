{
  "name": "sessify",
  "private": true,
  "type": "module",
  "author": {
    "name": "Deri Kurniawan",
    "email": "hi@derikn.com",
    "url": "https://www.derikn.com"
  },
  "homepage": "https://sessify.derikn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deri-Kurniawan/sessify-browser-extension.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ext": "turbo run dev --filter=ext",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "lint:write": "turbo run lint:write",
    "format": "turbo run format",
    "format:write": "turbo run format:write",
    "check": "biome check --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsdown": "^0.18.3",
    "turbo": "^2.7.2",
    "ultracite": "6.5.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.2.5",
      "@hookform/resolvers": "^5.2.2",
      "@t3-oss/env-nextjs": "^0.13.10",
      "@tailwindcss/postcss": "^4.1.18",
      "@types/node": "^25.0.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "dotenv": "^17.2.3",
      "drizzle-orm": "^0.45.1",
      "elysia": "^1.4.19",
      "jiti": "^2.6.1",
      "lucide-react": "^0.562.0",
      "moment": "^2.30.1",
      "motion": "^12.23.26",
      "next": "15.5.7",
      "next-themes": "^0.4.6",
      "nuqs": "^2.8.6",
      "postcss": "^8.5.6",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-hook-form": "^7.69.0",
      "react-icons": "^5.5.0",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.1.18",
      "tailwind-merge": "^3.4.0",
      "tldts": "^7.0.16",
      "tsdown": "^0.18.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5",
      "zod": "^4.2.1"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.2",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  }
}
