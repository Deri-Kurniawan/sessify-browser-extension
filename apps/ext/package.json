{
  "name": "ext",
  "launcherName": "Sessify",
  "description": "Manage and switch between multiple browser sessions effortlessly. Save and switch session with ease.",
  "private": true,
  "version": "0.1.1",
  "version_name": "0.1.1",
  "type": "module",
  "author": {
    "name": "Deri Kurniawan",
    "email": "hi@derikn.com",
    "url": "https://www.derikn.com"
  },
  "homepage": "https://sessify.derikn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deri-Kurniawan/sessify-browser-extension.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "biome check ./src",
    "lint:write": "biome check --write ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@sessify/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "catalog:",
    "lucide-react": "catalog:",
    "moment": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "^7.9.4",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tldts": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "catalog:",
    "wxt": "^0.20.6"
  },
  "engines": {
    "bun": ">=1.3.1"
  },
  "bun-version": "1.3.1"
}
