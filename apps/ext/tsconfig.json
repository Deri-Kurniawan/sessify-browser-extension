{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sessify/ui": ["../../packages/ui/src"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  }
}
